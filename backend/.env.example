# GitHub API Token
# 用于后续通过 GitHub API 获取 PR 信息、changed files 和 diff
# 示例：GITHUB_TOKEN=github_pat_xxxxxxxxx
GITHUB_TOKEN=your_github_token_here

# GitHub Integration
# false：真实请求 GitHub REST API 获取 PR 元数据和 changed files
# true：完全使用本地 mock 数据，适合无网络时调试 UI
USE_MOCK_GITHUB=false
GITHUB_API_BASE=https://api.github.com
GITHUB_TIMEOUT_SECONDS=15
GITHUB_MAX_FILES=100

# LLM Provider
# 当前项目支持通过 OpenAI-compatible API 调用大模型
# siliconflow 表示使用硅基流动
LLM_PROVIDER=siliconflow

# LLM Model
# 请在硅基流动控制台复制你实际可用的模型名称
# 示例：
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# LLM_MODEL=deepseek-ai/DeepSeek-V3
LLM_MODEL=your_model_name_here

# LLM API Base URL
# 硅基流动 OpenAI-compatible API 地址
LLM_API_BASE=https://api.siliconflow.cn/v1

# LLM API Key
# 注意：这里只写占位符，不要写真实密钥
LLM_API_KEY=your_siliconflow_api_key_here

# App Environment
# local 表示本地开发环境
APP_ENV=local

# LLM Runtime
# false：默认真实请求 OpenAI-compatible API
# true：完全使用本地 mock review，适合断网、前端联调和回归测试
USE_MOCK_LLM=false

# true：真实 LLM 调用失败或结构化校验失败时，自动回退到本地 mock review
# false：真实 LLM 失败时直接将任务标记为 failed
LLM_FALLBACK_TO_MOCK=true

LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_REVIEW_FILES=20
LLM_MAX_PATCH_CHARS=8000
LLM_MAX_CONTEXT_CHARS=45000
LLM_USE_JSON_RESPONSE_FORMAT=true

# Context Pack v1
# Conservative defaults keep prompts bounded while adding repo/file context.
CONTEXT_ENABLE=true
CONTEXT_MAX_TOTAL_CHARS=100000
CONTEXT_MAX_FILE_CHARS=12000
CONTEXT_MAX_HUNK_CONTEXT_CHARS=16000
CONTEXT_MAX_RELATED_FILE_CHARS=6000
CONTEXT_HUNK_BEFORE_LINES=40
CONTEXT_HUNK_AFTER_LINES=40
CONTEXT_MAX_CHANGED_FILES_DETAILED=8
CONTEXT_MAX_RELATED_FILES=6
CONTEXT_MAX_TREE_ITEMS=300
CONTEXT_SKIP_BINARY=true
CONTEXT_SKIP_LOCK_FILES=true
CONTEXT_SKIP_LARGE_PATCH_CHARS=20000
